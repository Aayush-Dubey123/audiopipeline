# ==============================================================================
# Root Git Ignore Rules
# ==============================================================================

# Local environment configuration (never commit secrets)
.env
.env.*
!.env.example

# Credentials, keys, and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Local databases and SQLite files
*.sqlite
*.sqlite3
*.db
!Thumbs.db

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Logs (keep directory structure with .gitkeep)
*.log
logs/*
backend/logs/*
mcp/logs/*
!logs/.gitkeep
!backend/logs/.gitkeep

# Node / Frontend build outputs & dependencies
node_modules/
dist/
build/
.output/
.wrangler/
.tanstack/
.vercel/

# OS and IDE files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo

