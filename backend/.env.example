# ==============================================================================
# AudioPipeline V1 - Backend Environment Configuration Template
# Copy this file to backend/.env and adjust values for your local environment.
# NEVER commit real credentials, tokens, or production secrets to source control.
# ==============================================================================

# Application Environment (development / production)
ENV=development
DEBUG=false

# Network: 127.0.0.1 keeps the studio private to this PC. Use 0.0.0.0 only in Docker/LAN.
HOST=127.0.0.1
PORT=8000
# Only true behind a trusted reverse proxy; otherwise clients can spoof their IP to dodge limits
TRUST_PROXY_HEADERS=false

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Database Configuration (SQLite default; PostgreSQL supported via postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./voice_studio.db

# Storage & Catalog Paths (relative to backend/ or absolute)
TMP_DIR=storage/tmp
VOICES_DIR=voices

# Upload & Processing Limits
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=120
MAX_TEXT_CHARS=30000

# Long-Form TTS Chunking & Quota Policies
CHUNK_MAX_CHARS=220
CHUNK_PAUSE_SENTENCE_MS=350
CHUNK_PAUSE_PARAGRAPH_MS=750
CHUNK_TIMEOUT_SECONDS=180
JOB_MAX_SECONDS=7200
CLIENT_DAILY_MINUTES=120

# Job Queue & Retention Policies
JOB_TTL_MINUTES=120
QUEUE_MAX_SIZE=10
JOB_TIMEOUT_SECONDS=180
RATE_LIMIT_PER_MINUTE=10

# Storage hygiene: completed jobs keep only output.wav + output.mp3; everything else is purged
CLEANUP_INTERVAL_SECONDS=600
FAILED_JOB_TTL_MINUTES=60
CONDS_CACHE_MAX_FILES=10
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=1

# Model Execution & Concurrency
CHATTERBOX_IN_PROCESS=true
# auto = GPU if present (fast). cpu = zero GPU load but ~5-10x slower.
CHATTERBOX_DEVICE=auto
# Voice-match tuning: expressiveness, guidance (lower = closer to reference pace/accent), sampling temperature
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.4
CHATTERBOX_TEMPERATURE=0.75
# Native model rate; 44100 just makes bigger files with no extra quality
OUTPUT_SAMPLE_RATE=24000
# Release GPU memory after this many idle seconds (0 = keep loaded)
MODEL_IDLE_UNLOAD_SECONDS=300
CHATTERBOX_PYTHON_PATH=
EXPOSE_EXPERIMENTAL_VOICES=false

# Confidence Scoring Thresholds
TTS_CONFIDENCE_GOOD_THRESHOLD=0.70
TTS_CONFIDENCE_FAIR_THRESHOLD=0.56

# Optional External Language Services (leave blank if unused; app runs offline with rules)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
