# ==============================================================================
# AI Voice Studio - Backend Environment Configuration Template
# Copy this file to backend/.env and adjust values for your local environment.
# NEVER commit real credentials, tokens, or production secrets to source control.
# ==============================================================================

# Application Environment (development / production)
ENV=development
DEBUG=true

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./voice_studio.db

# Storage & Catalog Paths (relative to backend/ or absolute)
TMP_DIR=storage/tmp
VOICES_DIR=voices

# Upload & Processing Limits
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=120
MAX_TEXT_CHARS=1000

# Job Queue & Retention Policies
JOB_TTL_MINUTES=60
QUEUE_MAX_SIZE=10
JOB_TIMEOUT_SECONDS=180
RATE_LIMIT_PER_MINUTE=10

# Optional External Language Services (leave blank if unused; app runs without them)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
