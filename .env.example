# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace placeholders with your local/production settings.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=universal_db

# Security & Authentication
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
