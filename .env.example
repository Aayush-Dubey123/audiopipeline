# ==============================================================================
# AudioPipeline V1 — Root Environment Configuration Template
# Copy this file to .env and adjust values for your local/production environment.
# NEVER commit real credentials, tokens, or production secrets to source control.
# ==============================================================================

# Application Environment (development / production)
ENV=development
DEBUG=true

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./storage/voice_studio.db

# Storage Directories
TMP_DIR=storage/tmp
VOICES_DIR=voices

# Inference Engine Settings
CHATTERBOX_IN_PROCESS=true
EXPOSE_EXPERIMENTAL_VOICES=false

# Limits
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=120
MAX_TEXT_CHARS=30000
CHUNK_MAX_CHARS=220
RATE_LIMIT_PER_MINUTE=10
CLIENT_DAILY_MINUTES=120

# Optional External API Keys (Offline rule-based fallback active by default)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
