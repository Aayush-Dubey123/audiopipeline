---
/**
 * Before/after audio comparison: one play button, two waveforms, switching keeps the playhead.
 * Data comes from src/data/showcase.json (rendered by the project's showcase script).
 */
import data from '../data/showcase.json';

interface Props {
	lang: 'en' | 'hi';
	title?: string;
	showText?: boolean;
}

const { lang, title, showText = false } = Astro.props;
const sample = (data as any)[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uid = `ap-${lang}-${Math.random().toString(36).slice(2, 8)}`;

const tracks = [
	{
		key: 'before',
		label: 'Before',
		sub: 'Original pipeline',
		src: `${base}/audio/${lang}-before.mp3`,
		info: sample.before,
	},
	{
		key: 'after',
		label: 'After',
		sub: 'Improved pipeline',
		src: `${base}/audio/${lang}-after.mp3`,
		info: sample.after,
	},
];

const W = 480;
const H = 72;
function bars(peaks: number[]) {
	const max = Math.max(...peaks, 0.001);
	return peaks.map((p, i) => {
		const h = Math.max((p / max) * (H - 6), 1.5);
		return { x: i + 0.2, y: (H - h) / 2, h };
	});
}
---

<figure class="ap-compare ap-card" id={uid} data-active="after">
	<figcaption class="ap-compare-head">
		<div>
			<span class="ap-eyebrow">{lang === 'hi' ? 'Hindi · हिन्दी' : 'English'}</span>
			{title && <h3 class="ap-compare-title">{title}</h3>}
		</div>
		<div class="ap-toggle" role="tablist" aria-label="Choose version">
			{
				tracks.map((t) => (
					<button type="button" role="tab" data-key={t.key} aria-selected={t.key === 'after' ? 'true' : 'false'}>
						{t.label}
					</button>
				))
			}
		</div>
	</figcaption>

	{
		tracks.map((t) => (
			<div class="ap-track" data-key={t.key}>
				<div class="ap-track-label">
					<strong>{t.label}</strong>
					<span>{t.sub}</span>
				</div>
				<svg
					class="ap-wave"
					viewBox={`0 0 ${W} ${H}`}
					preserveAspectRatio="none"
					role="img"
					aria-label={`${t.label} waveform, ${t.info.duration} seconds`}
				>
					<defs>
						<clipPath id={`${uid}-${t.key}-clip`}>
							<rect class="ap-progress" x="0" y="0" width="0" height={H} />
						</clipPath>
					</defs>
					<g class="ap-bars-dim">
						{bars(t.info.peaks).map((b) => (
							<rect x={b.x} y={b.y} width="0.6" height={b.h} rx="0.3" />
						))}
					</g>
					<g class="ap-bars-lit" clip-path={`url(#${uid}-${t.key}-clip)`}>
						{bars(t.info.peaks).map((b) => (
							<rect x={b.x} y={b.y} width="0.6" height={b.h} rx="0.3" />
						))}
					</g>
				</svg>
				<ul class="ap-chips">
					<li>{t.info.duration}s</li>
					<li class={t.info.digital_silence_ms > 300 ? 'bad' : 'good'}>
						{t.info.digital_silence_ms} ms dead silence
					</li>
					<li>noise floor {t.info.noise_floor_db} dB</li>
				</ul>
				<audio preload="none" data-src={t.src} />
			</div>
		))
	}

	<div class="ap-controls">
		<button type="button" class="ap-play" aria-label="Play">
			<svg viewBox="0 0 24 24" aria-hidden="true" class="ap-icon-play"><path d="M8 5v14l11-7z" /></svg>
			<svg viewBox="0 0 24 24" aria-hidden="true" class="ap-icon-pause"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
		</button>
		<span class="ap-time">0:00</span>
		<span class="ap-hint">Switch Before/After while playing; the position is kept so you can compare the same moment.</span>
	</div>

	{
		showText && (
			<details class="ap-script">
				<summary>Script used ({sample.chunks.length} chunks)</summary>
				<ol>
					{sample.chunks.map((c: string) => (
						<li>{c}</li>
					))}
				</ol>
			</details>
		)
	}
</figure>

<script>
	function fmt(s: number) {
		const m = Math.floor(s / 60);
		return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
	}

	const metadata = (a: HTMLAudioElement) =>
		a.readyState >= 1 ? Promise.resolve() : new Promise<void>((r) => a.addEventListener('loadedmetadata', () => r(), { once: true }));

	document.querySelectorAll<HTMLElement>('.ap-compare').forEach((root) => {
		const audios = new Map<string, HTMLAudioElement>();
		root.querySelectorAll<HTMLElement>('.ap-track').forEach((t) => {
			audios.set(t.dataset.key!, t.querySelector('audio')!);
		});
		const playBtn = root.querySelector<HTMLButtonElement>('.ap-play')!;
		const time = root.querySelector<HTMLElement>('.ap-time')!;
		const active = () => audios.get(root.dataset.active!)!;

		// Fetch both clips into memory on first use. In-memory (blob) audio is always seekable,
		// even when the host ignores HTTP Range requests, so Before/After can keep the playhead.
		let loading: Promise<void> | null = null;
		const ensureLoaded = () =>
			(loading ??= Promise.all(
				[...audios.values()].map(async (a) => {
					try {
						const res = await fetch(a.dataset.src!);
						if (!res.ok) throw new Error(String(res.status));
						a.src = URL.createObjectURL(await res.blob());
					} catch {
						a.src = a.dataset.src!; // fall back to streaming
					}
					a.load();
					await metadata(a);
				}),
			).then(() => undefined));

		const paint = () => {
			audios.forEach((a, key) => {
				const rect = root.querySelector<SVGRectElement>(`.ap-track[data-key="${key}"] .ap-progress`)!;
				const frac = a.duration ? a.currentTime / a.duration : 0;
				rect.setAttribute('width', String(frac * 480));
			});
			time.textContent = fmt(active().currentTime || 0);
		};

		const setPlaying = (on: boolean) => root.classList.toggle('is-playing', on);

		const select = async (key: string) => {
			if (key === root.dataset.active) return;
			const prev = active();
			const wasPlaying = !prev.paused;
			const at = prev.currentTime;
			prev.pause();
			root.dataset.active = key;
			root.querySelectorAll<HTMLButtonElement>('.ap-toggle button').forEach((b) =>
				b.setAttribute('aria-selected', String(b.dataset.key === key)),
			);
			await ensureLoaded();
			const next = active();
			next.currentTime = Math.min(at, Math.max((next.duration || at) - 0.05, 0));
			if (wasPlaying) await next.play().catch(() => {});
			paint();
		};

		root.querySelectorAll<HTMLButtonElement>('.ap-toggle button').forEach((b) =>
			b.addEventListener('click', () => select(b.dataset.key!)),
		);

		playBtn.addEventListener('click', async () => {
			// stop any other player on the page
			document.querySelectorAll<HTMLAudioElement>('.ap-compare audio').forEach((a) => {
				if (a !== active()) a.pause();
			});
			root.classList.add('is-loading');
			await ensureLoaded();
			root.classList.remove('is-loading');
			const a = active();
			if (a.paused) await a.play().catch(() => {});
			else a.pause();
		});

		audios.forEach((a, key) => {
			a.addEventListener('timeupdate', paint);
			a.addEventListener('play', () => setPlaying(true));
			a.addEventListener('pause', () => {
				if (key === root.dataset.active) setPlaying(false);
			});
			a.addEventListener('ended', () => setPlaying(false));
		});

		root.querySelectorAll<HTMLElement>('.ap-track').forEach((t) => {
			const svg = t.querySelector('svg')!;
			svg.addEventListener('click', async (e) => {
				const key = t.dataset.key!;
				const r = svg.getBoundingClientRect();
				const frac = (e.clientX - r.left) / r.width;
				await select(key);
				await ensureLoaded();
				const a = audios.get(key)!;
				a.currentTime = frac * a.duration;
				paint();
			});
		});
	});
</script>

<style>
	.ap-compare {
		margin-block: 1.5rem;
		display: grid;
		gap: 0.9rem;
	}
	.ap-compare-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.ap-compare-title {
		margin: 0.15rem 0 0;
		font-size: 1.1rem;
	}
	.ap-toggle {
		display: inline-flex;
		background: var(--sl-color-gray-6);
		border-radius: 999px;
		padding: 3px;
	}
	.ap-toggle button {
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.35rem 0.95rem;
		border-radius: 999px;
		cursor: pointer;
	}
	.ap-toggle button[aria-selected='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ap-track {
		display: grid;
		gap: 0.35rem;
		opacity: 0.45;
		transition: opacity 0.2s ease;
	}
	.ap-compare[data-active='before'] .ap-track[data-key='before'],
	.ap-compare[data-active='after'] .ap-track[data-key='after'] {
		opacity: 1;
	}
	.ap-track-label {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		font-size: 0.85rem;
	}
	.ap-track-label span {
		color: var(--sl-color-gray-3);
	}
	.ap-wave {
		width: 100%;
		height: 64px;
		cursor: pointer;
		display: block;
	}
	.ap-track[data-key='before'] .ap-bars-lit {
		fill: var(--ap-wave-before);
	}
	.ap-track[data-key='after'] .ap-bars-lit {
		fill: var(--ap-wave-after);
	}
	.ap-bars-dim {
		fill: var(--sl-color-gray-4);
		opacity: 0.55;
	}
	.ap-track[data-key='before'] .ap-bars-dim {
		fill: var(--ap-wave-before);
		opacity: 0.32;
	}
	.ap-track[data-key='after'] .ap-bars-dim {
		fill: var(--ap-wave-after);
		opacity: 0.32;
	}
	.ap-chips {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin: 0 !important;
	}
	.ap-chips li {
		margin: 0 !important;
		font-size: 0.75rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	.ap-chips li.bad {
		background: var(--ap-red-soft);
		color: var(--ap-red);
	}
	.ap-chips li.good {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.ap-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.ap-play {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 0;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		display: grid;
		place-items: center;
		cursor: pointer;
		flex: none;
	}
	.ap-play svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}
	.ap-compare.is-loading .ap-play {
		opacity: 0.6;
		cursor: progress;
	}
	.ap-icon-pause,
	.ap-compare.is-playing .ap-icon-play {
		display: none;
	}
	.ap-compare.is-playing .ap-icon-pause {
		display: block;
	}
	.ap-time {
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}
	.ap-hint {
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		flex: 1 1 14rem;
	}
	.ap-script summary {
		cursor: pointer;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
	.ap-script ol {
		font-size: 0.85rem;
	}
</style>
