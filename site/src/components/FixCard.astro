---
/** One weak point: what was wrong, the evidence, the fix, and the measured result. */
interface Props {
	n: number;
	title: string;
	area: string;
	problem: string;
	evidence?: string;
	fix: string;
	result: string;
}
const { n, title, area, problem, evidence, fix, result } = Astro.props;
---

<article class="ap-fix ap-card">
	<header>
		<span class="ap-fix-n">{String(n).padStart(2, '0')}</span>
		<div>
			<span class="ap-eyebrow">{area}</span>
			<h3>{title}</h3>
		</div>
	</header>
	<dl>
		<div class="row problem"><dt>Problem</dt><dd>{problem}</dd></div>
		{evidence && <div class="row"><dt>Evidence</dt><dd>{evidence}</dd></div>}
		<div class="row"><dt>Fix</dt><dd>{fix}</dd></div>
		<div class="row result"><dt>Result</dt><dd>{result}</dd></div>
	</dl>
</article>

<style>
	.ap-fix {
		margin-block: 1rem !important;
	}
	header {
		display: flex;
		gap: 0.85rem;
		align-items: center;
		margin-bottom: 0.75rem;
	}
	h3 {
		margin: 0.1rem 0 0 !important;
		font-size: 1.05rem;
	}
	.ap-fix-n {
		flex: none;
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--sl-color-gray-4);
		font-variant-numeric: tabular-nums;
	}
	dl {
		margin: 0 !important;
		display: grid;
		gap: 0.45rem;
	}
	.row {
		margin: 0 !important;
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 0.75rem;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	dt {
		font-weight: 650;
		color: var(--sl-color-gray-3);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding-top: 0.15rem;
	}
	dd {
		margin: 0 !important;
	}
	.problem dt {
		color: var(--ap-red);
	}
	.result dt {
		color: var(--ap-green);
	}
	.result dd {
		font-weight: 600;
	}
	@media (max-width: 30rem) {
		.row {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
	}
</style>
